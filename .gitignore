# Build output
/target/

# Vendored third-party repos (have their own git history)
/Windows-driver-samples/
/low-latency-audio/

# Measurement captures and logs (large, machine-specific recordings)
/measure/dump_*/
/measure/*.wav
/measure/*.log
/measure/*.packets.txt
/measure/__pycache__/

# Editor / OS
__pycache__/
*.pyc
.vscode/
.idea/
Thumbs.db
desktop.ini

# Rust leftovers
**/*.rs.bk

# Claude Code local state
.claude/settings.local.json

# Pi session/agent local state (skills/workflows, if ever added, get re-included)
/.pi/*
!/.pi/teams/
/.pi/teams/*
!/.pi/teams/artifacts/
!/.pi/teams/graphs/
/.pi/teams/state/
/.pi/teams/cache/
/.pi/teams/worktrees/
/.pi/teams/imports/
/.pi/teams/audit/

# pi-crew runtime state
/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep/.pi/teams/artifacts/**/transcripts/
/.pi/teams/artifacts/**/sessions/
/.pi/teams/artifacts/**/logs/
/.pi/teams/artifacts/**/metadata/
/.pi/teams/artifacts/**/perf-obs.log
